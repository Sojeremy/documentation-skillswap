@startuml deployement
skinparam nodeStyle rectangle
skinparam wrapWidth 200
skinparam maxMessageSize 150

title Diagramme de déploiement – SkillSwap (Docker, production)

actor Utilisateur


node "Navigateur Web" {
  component "Browser"
}

node "VPS OVH (Ubuntu)" {

    node "Docker Network\n(skillswap-prod)" {
        node "Reverse Proxy\nskillswap-nginx-prod\n(nginx:alpine)" as Nginx {
          component "TLS Let's Encrypt\nHTTPS / Routing"
        }

        node "Frontend Container\nskillswap-frontend-1" {
          component "Next.js 16 standalone\n(port 3000 interne)" as Next
        }

        node "Backend Container\nskillswap-backend-1" {
          component "Express 5 API\n(port 3000 interne)" as API
          component "WebSocket Server\nSocket.io" as WS
        }

        node "skillswap-postgres-prod" as DBNode {
          component "PostgreSQL 16-alpine\n(port 5432 interne)" as DB
        }

        node "skillswap-meilisearch-prod" as SearchNode {
          component "Meilisearch v1.6\n(port 7700 interne)" as Search
        }

        node "skillswap-certbot\n(side-container)" as Certbot {
          component "certbot/certbot\nrenew loop 12h"
        }
    }

    node "Docker Volumes" {
      component "postgres_data"
      component "meilisearch_data"
      component "avatars_data"
      component "certbot_www / certbot_conf"
    }

}

note right of Nginx
  **Adminer n'est pas déployé en production.**
  Le service Adminer (interface web Postgres)
  est uniquement présent dans
  docker-compose.dev.yml.
end note

' ===== ACCÈS UTILISATEURS =====
Utilisateur --> Browser

Browser --> Nginx : HTTPS (443)

' ===== ROUTAGE =====
Nginx --> Next : HTTP (3000)
Nginx --> API : HTTP (3000) /api/*
Nginx --> WS : WebSocket /socket.io/

' ===== COMMUNICATION INTERNE =====
Next --> API : REST / Fetch (interne)
API --> DB : Prisma 7 (TCP 5432)
API --> Search : HTTP 7700
WS --> DB : Persistance messages

' ===== VOLUMES =====
DB ~~ "postgres_data"
Search ~~ "meilisearch_data"
API ~~ "avatars_data"
Nginx ~~ "certbot_www / certbot_conf"
Certbot ~~ "certbot_www / certbot_conf"

@enduml
