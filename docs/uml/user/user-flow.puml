@startuml userflow
!theme plain
title SkillSwap — UserFlow (Frontend)

skinparam backgroundColor #FFFFFF
skinparam roundCorner 10
skinparam shadowing false
skinparam defaultFontName Inter
skinparam defaultFontSize 12
skinparam linetype ortho

skinparam rectangle {
  BackgroundColor #F9FAFB
  BorderColor #E5E7EB
  FontColor #111827
}

skinparam rectangle<<public>> {
  BackgroundColor #DBEAFE
  BorderColor #3B82F6
  FontColor #1E40AF
}

skinparam rectangle<<auth>> {
  BackgroundColor #FEE2E2
  BorderColor #EF4444
  FontColor #991B1B
}

skinparam rectangle<<member>> {
  BackgroundColor #D1FAE5
  BorderColor #10B981
  FontColor #065F46
}

skinparam rectangle<<flow>> {
  BackgroundColor #FEF3C7
  BorderColor #F59E0B
  FontColor #92400E
}

legend right
  |<#DBEAFE>| Public (sans auth) |
  |<#FEE2E2>| Auth (groupe (auth)/) |
  |<#D1FAE5>| Membre (groupe (app)/) |
  |<#FEF3C7>| Action contextuelle |
endlegend

rectangle "SKILLSWAP (Frontend Next.js App Router)" as app {

  rectangle "/ (Landing — Server Component, ISR 3600s)" as home <<public>>
  rectangle "/profil/[id] (teaser SEO public, ISR 3600s)" as profile_public <<public>>

  rectangle "Groupe (auth)/" as auth_group <<auth>> {
    rectangle "/connexion" as login
    rectangle "/inscription" as register
  }

  rectangle "Groupe (app)/ — protégé par middleware.ts" as member_area <<member>> {
    rectangle "/recherche" as search
    rectangle "/profil/[id] (vue Full)" as profile_full
    rectangle "/mon-profil (édition)" as profile_edit
    rectangle "/conversation\n(liste + thread + Socket.IO)" as conversation
    rectangle "Dialog Rating\n(post-clôture)" as rating <<flow>>
  }
}

' ----------------------
' UserFlow principal
' ----------------------
home --> login : "se connecter"
home --> register : "s'inscrire"
home --> profile_public : "voir un profil mis en avant"
home --> search : "(redirige vers /connexion si non auth\nvia middleware.ts)"

login --> search : "succès → redirect=/recherche\n(ou ?redirect=...)"
register --> search : "succès → redirect=/recherche"

search --> profile_full : "ouvrir un profil (auth)"
profile_public --> login : "CTA inscription / connexion"

profile_full --> conversation : "démarrer un échange\n(POST /conversations + middleware requireSimpleFollow)"

conversation --> rating : "clôturer → noter (Dialog)"

profile_full --> profile_edit : "(si propriétaire)"

@enduml
