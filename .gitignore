docker-compose.override.yml
devops/postgres_data/

# Mac / Windows / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Prisma client généré (régénéré via prisma generate)
backend/prisma/generated/
**/prisma/generated/
# Note: Les migrations NE doivent PAS être ignorées pour la collaboration

